# 复制为部署目录里的 .env 后填写（这个文件里有密码和密钥：chmod 600 .env，不要提交）

# --- 域名和证书 ---
# 网站的域名（DNS 的 A 记录要先指向这台服务器，Caddy 才能申请到证书）
DOMAIN=app.example.com
# Let's Encrypt 用来通知证书问题
ACME_EMAIL=you@example.com

# --- 数据库 ---
# 随机生成一个，例如 openssl rand -hex 32（只用字母和数字，免得在连接串里要转义）
POSTGRES_PASSWORD=

# --- 邮件（AWS SES） ---
# 发件人：域名要在 SES 里验证过
EMAIL_FROM=个人助手 <no-reply@example.com>
SES_REGION=us-east-1
# 只能发邮件的 IAM 用户（权限见 deploy/README.md）
SES_AWS_ACCESS_KEY_ID=
SES_AWS_SECRET_ACCESS_KEY=
# 还没开通 SES 时可以先设成 console：邮件只打印在 worker 的日志里（docker compose logs worker）
# EMAIL_BACKEND=console

# --- 备份 ---
# 不填时只在部署目录的 backups/ 里保留最近 7 天
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=backups/
BACKUP_S3_REGION=us-east-1
# 只能往这个存储桶写的 IAM 用户（权限见 deploy/README.md）
BACKUP_AWS_ACCESS_KEY_ID=
BACKUP_AWS_SECRET_ACCESS_KEY=

# --- 镜像 ---
# 默认用 CI 构建的最新版本；回滚时改成某次提交的 SHA
# IMAGE_TAG=latest
