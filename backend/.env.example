# 复制为 backend/.env 后按需修改；所有变量都有适合本地开发的默认值
PA_ENV=dev
PA_DATABASE_URL=postgresql+asyncpg://pa:pa@localhost:5433/pa
# 前端地址：用于邮件里的链接，以及 CSRF 的 Origin 校验
PA_APP_BASE_URL=http://localhost:5173

# 邮件：dev 默认走 SMTP → Mailpit（http://localhost:8026 查看）
PA_EMAIL_BACKEND=smtp
PA_SMTP_HOST=localhost
PA_SMTP_PORT=1026
PA_EMAIL_FROM=Personal Assistant <no-reply@localhost>

# --- 生产环境参考 ---
# PA_ENV=prod                         # 自动开启 Secure Cookie、关闭 /api/docs
# PA_APP_BASE_URL=https://app.example.com
# PA_SESSION_COOKIE_NAME=__Host-pa_session   # __Host- 前缀：浏览器强制 Secure、Path=/、不可跨子域
# PA_EMAIL_BACKEND=resend
# PA_RESEND_API_KEY=re_...
# PA_EMAIL_FROM=个人助手 <no-reply@example.com>
# 用 SES 时：PA_EMAIL_BACKEND=ses、PA_SES_REGION=us-east-1，
# AWS 凭证走 boto3 标准链（实例角色或 AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY）
